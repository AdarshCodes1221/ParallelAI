GEMINI_API_KEY=
GROQ_API_KEY=
PRIMARY_LLM_PROVIDER=ollama
FALLBACK_LLM_PROVIDER=groq
LLM_MODE=offline
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=llama3.2:3b
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://parallel:parallel@localhost:5432/parallel_ai
S3_ENDPOINT_URL=
S3_BUCKET=parallel-ai-originals
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
DOCUMENT_STORAGE_PATH=/app/storage
FRONTEND_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=50
ENABLE_RERANKER=false
ENABLE_SEMANTIC_CACHE=true
AUTH_LOGIN_RATE_LIMIT=10
AUTH_SIGNUP_RATE_LIMIT=10
AUTH_FORGOT_PASSWORD_RATE_LIMIT=5
AUTH_RESET_PASSWORD_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
PORT=8000
HOST=0.0.0.0
ENV=development
